{
  "name": "rentable",
  "version": "1.0.0",
  "description": "Rentable project root",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "./run-frontend.sh",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "clear:bookings": "npm --prefix backend run clear:bookings",
    "seed": "npm --prefix backend run seed",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "20": "^1.0.0"
  }
}
